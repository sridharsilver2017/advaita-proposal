# Advaita Designs - Environment Configuration

# Server & Application
PORT=5173
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
JWT_SECRET=super_secret_session_key_minimum_32_characters_long

# Cloudflare D1 & R2 (Production)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=af401bd5-b0c9-495b-85e6-4fc2e113cbe9
CLOUDFLARE_R2_BUCKET_NAME=advaita-documents
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Transactional Email Provider (Resend / SendGrid / Cloudflare Email)
EMAIL_PROVIDER=resend # 'resend' | 'sendgrid' | 'mock'
RESEND_API_KEY=
EMAIL_FROM=Advaita Designs <proposals@advaitadesigns.com>
EMAIL_REPLY_TO=hello@advaitadesigns.com

# Electronic Signature Provider (Optional external adapter, e.g., DocuSign / SignRequest / Native)
ESIGN_PROVIDER=native # 'native' | 'docusign'

# Security & Anti-abuse
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
